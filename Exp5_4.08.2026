    {
      "cell_type": "markdown",
      "source": [
        "**BINNING**"
      ],
      "metadata": {
        "id": "Rx3IYbmNcK-V"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 465
        },
        "id": "c34d0ec1",
        "outputId": "9656ec4a-d248-4370-84b0-3dcaef2d0c96"
      },
      "source": [
        "# Example: Binning 'TotalPrice' into custom intervals\n",
        "# Define bins based on the range of TotalPrice\n",
        "min_price = df['TotalPrice'].min()\n",
        "max_price = df['TotalPrice'].max()\n",
        "\n",
        "bins = [min_price, 1000000, 3000000, 5000000, max_price]\n",
        "labels = ['Low Sales', 'Medium Sales', 'High Sales', 'Very High Sales']\n",
        "\n",
        "df['TotalPrice_Category_Cut'] = pd.cut(df['TotalPrice'], bins=bins, labels=labels, include_lowest=True)\n",
        "display(df[['TotalPrice', 'TotalPrice_Category_Cut']].head())\n",
        "print('\\nValue counts for TotalPrice_Category_Cut:')\n",
        "display(df['TotalPrice_Category_Cut'].value_counts())"
      ],
      "execution_count": 10,
      "outputs": [
