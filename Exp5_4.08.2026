      "source": [
        "## Data Binning with `pd.qcut` (Quantile-based)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 465
        },
        "id": "7eb44040",
        "outputId": "b0de6235-265b-444f-dd2a-be6f03180e0f"
      },
      "source": [
        "# Example: Binning 'TotalPrice' into quartiles\n",
        "df['TotalPrice_Category_Qcut'] = pd.qcut(df['TotalPrice'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])\n",
        "display(df[['TotalPrice', 'TotalPrice_Category_Qcut']].head())\n",
        "print('\\nValue counts for TotalPrice_Category_Qcut:')\n",
        "display(df['TotalPrice_Category_Qcut'].value_counts())"
      ],
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
