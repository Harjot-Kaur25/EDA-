      },
      "source": [
        "# Identify transactions with TotalPrice greater than 3,000,000 (as per the example)\n",
        "large_transactions = df[df['TotalPrice'] > 3000000]\n",
        "print(\"Transactions with TotalPrice > 3,000,000:\")\n",
        "display(large_transactions.head())\n",
        "\n",
        "# Identify transactions with TotalPrice greater than 6,741,112 (as per the example)\n",
        "extremely_large_transactions = df[df['TotalPrice'] > 6741112]\n",
        "print(\"\\nTransactions with TotalPrice > 6,741,112:\")\n",
        "display(extremely_large_transactions)"
      ],
