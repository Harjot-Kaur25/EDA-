      },
      "source": [
        "## Data Loading and Initial Preparation"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 585
        },
        "id": "c9795595",
        "outputId": "5fc60897-a93e-4e8f-ad53-c1eae0cf0261"
      },
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import zipfile\n",
        "import os\n",
        "\n",
        "\n",
        "zip_file_path = '/content/CreditCard.zip'\n",
        "extracted_dir = '/content/extracted_creditcard_data/'\n",
        "\n",
        "os.makedirs(extracted_dir, exist_ok=True)\n",
        "\n",
        "print(f\"Extracting {zip_file_path} to {extracted_dir}...\")\n",
        "with zipfile.ZipFile(zip_file_path, 'r') as zip_ref:\n",
        "    zip_ref.extractall(extracted_dir)\n",
        "print(\"Extraction complete.\")\n",
        "\n",
        "all_extracted_files = []\n",
        "for root, dirs, files in os.walk(extracted_dir):\n",
        "    for file in files:\n",
        "        all_extracted_files.append(os.path.join(root, file))\n",
        "\n",
        "print(f\"Files found in '{extracted_dir}':\\n{all_extracted_files}\")\n",
        "\n",
        "csv_files = [f for f in all_extracted_files if f.endswith('.csv')]\n",
        "\n",
        "if csv_files:\n",
        "\n",
        "    csv_file_path = csv_files[0]\n",
        "    print(f\"Loading data from {csv_file_path}...\")\n",
        "    df = pd.read_csv(csv_file_path)\n",
        "    print(\"Data loaded successfully.\")\n",
        "else:\n",
        "    print(f\"No CSV files found in {extracted_dir} or its subdirectories. Please specify the correct file to load.\")\n",
        "    df = pd.DataFrame()\n",
        "\n",
        "display(df.head())"
      ],
      "execution_count": 2,
