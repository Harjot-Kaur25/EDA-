    {
      "cell_type": "markdown",
      "metadata": {
        "id": "8f427a5f"
      },
      "source": [
        "## Outlier Detection and Filtering"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "25dc2a2d",
        "outputId": "e73f50dd-2730-467b-8f34-3f7150e4b975"
      },
      "source": [
        "\n",
        "\n",
        "Q1 = df['amt'].quantile(0.25)\n",
        "Q3 = df['amt'].quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "upper_bound = Q3 + 1.5 * IQR\n",
        "lower_bound = Q1 - 1.5 * IQR\n",
        "\n",
        "print(f\"IQR for 'amt': {IQR:.2f}\")\n",
        "print(f\"Upper bound for outliers: {upper_bound:.2f}\")\n",
        "print(f\"Lower bound for outliers: {lower_bound:.2f}\")\n",
        "\n",
        "\n",
        "outliers = df[(df['amt'] < lower_bound) | (df['amt'] > upper_bound)]\n",
        "\n",
        "print(f\"\\nNumber of detected outliers in 'amt': {len(outliers)}\")\n",
        "print(\"Outliers in 'amt' (first 10 rows, if any):\")\n",
        "display(outliers.head(10))\n",
        "\n",
        "\n",
        "if not outliers.empty:\n",
        "    print(\"\\nSummary statistics for 'amt' outliers:\")\n",
        "    display(outliers['amt'].describe())"
      ],
      "execution_count": 6,
      "outputs": [
        {
          "output_type": "stream",
