    {
      "cell_type": "markdown",
      "metadata": {
        "id": "1fdd4bc7"
      },
      "source": [
        "## Data Binning with `pd.qcut` (Quantile-based)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 465
        },
        "id": "7eb44040",
        "outputId": "2e99b126-98a0-46f4-8ef3-7a411153c158"
      },
      "source": [
        "\n",
        "df['Amount_Category_Qcut'] = pd.qcut(df['amt'], q=4, labels=['Q1', 'Q2', 'Q3', 'Q4'])\n",
        "display(df[['amt', 'Amount_Category_Qcut']].head())\n",
        "print('\\nValue counts for Amount_Category_Qcut:')\n",
        "display(df['Amount_Category_Qcut'].value_counts())"
      ],
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "     amt Amount_Category_Qcut\n",
              "0   2.86                   Q1\n",
              "1  29.84                   Q2\n",
              "2  41.28                   Q2\n",
              "3  60.05                   Q3\n",
              "4   3.19                   Q1"
