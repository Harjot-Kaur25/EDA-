    {
      "cell_type": "markdown",
      "source": [
        "**BINNING**"
      ],
      "metadata": {
        "id": "Rx3IYbmNcK-V"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 465
        },
        "id": "c34d0ec1",
        "outputId": "70cb6a12-02d9-499e-f9e5-797047e2f67c"
      },
      "source": [
        "\n",
        "min_amt = df['amt'].min()\n",
        "max_amt = df['amt'].max()\n",
        "\n",
        "\n",
        "quantiles = df['amt'].quantile([0.25, 0.5, 0.75]).tolist()\n",
        "bins = [min_amt] + quantiles + [max_amt]\n",
        "bins = sorted(list(set(bins)))\n",
        "\n",
        "\n",
        "if len(bins) == 2:\n",
        "    labels = ['All Amounts']\n",
        "elif len(bins) == 3:\n",
        "    labels = ['Low Amount', 'High Amount']\n",
        "elif len(bins) == 4:\n",
        "    labels = ['Low Amount', 'Medium Amount', 'High Amount']\n",
        "elif len(bins) == 5:\n",
        "    labels = ['Very Low Amount', 'Low Amount', 'Medium Amount', 'High Amount']\n",
        "else:\n",
        "\n",
        "    labels = [f'Amount_Cat_{i+1}' for i in range(len(bins)-1)]\n",
        "\n",
        "df['Amount_Category_Cut'] = pd.cut(df['amt'], bins=bins, labels=labels, include_lowest=True, right=True)\n",
        "display(df[['amt', 'Amount_Category_Cut']].head())\n",
        "print('\\nValue counts for Amount_Category_Cut:')\n",
        "display(df['Amount_Category_Cut'].value_counts(dropna=False))"
      ],
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "display_data",
