      "source": [
        "\n",
        "numerical_cols_for_scaling = ['amt', 'city_pop']\n",
        "\n",
        "\n",
        "standard_scaler = StandardScaler()\n",
        "df_standard_scaled = df.copy()\n",
        "df_standard_scaled[numerical_cols_for_scaling] = standard_scaler.fit_transform(df[numerical_cols_for_scaling])\n",
        "print(\"\\nStandardized Data (first 5 rows of selected numerical columns):\")\n",
        "display(df_standard_scaled[numerical_cols_for_scaling].head())"
      ],
